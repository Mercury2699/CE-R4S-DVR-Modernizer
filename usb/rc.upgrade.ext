#!/bin/sh
#
# rc.upgrade.ext - Automated USB Installer for Clinton Electronics Shadow DVRs
# Compatible with: CE-R4S, LT400, and related Astel / Faraday FA526 Linux 2.6.15 DVRs.
#
# Triggered automatically by /etc/rc.d/rc.upgrade upon boot or USB insertion.
#

LOG="/tmp/upgrade_installer.log"
echo "=============================================" > $LOG
echo "Clinton Shadow DVR Toolkit - Auto USB Installer" >> $LOG
echo "Started at: `date`" >> $LOG
echo "=============================================" >> $LOG

# 1. Discover and mount the USB flash drive
USB_MNT="/mnt/usb"
mkdir -p $USB_MNT

FOUND_DEV=""
for dev in /dev/sdb1 /dev/sdb /dev/sdc1 /dev/sdc /dev/sdd1 /dev/sdd /dev/sde1 /dev/sde; do
    if [ -b "$dev" ]; then
        mount "$dev" $USB_MNT 2>/dev/null
        if [ -d "$USB_MNT/payload" ]; then
            FOUND_DEV="$dev"
            echo "[+] Detected valid payload on USB device: $dev" >> $LOG
            break
        fi
        umount $USB_MNT 2>/dev/null
    fi
done

if [ -z "$FOUND_DEV" ]; then
    echo "[-] Error: Could not locate USB storage containing payload directory." >> $LOG
    exit 1
fi

PAYLOAD="$USB_MNT/payload"

# 2. Prepare target directories on MTD flash
echo "[*] Ensuring target directories /mtd/bin and /mtd/web exist..." >> $LOG
mkdir -p /mtd/bin /mtd/web

# 3. Stop running instances of astel_rtspd if present
echo "[*] Stopping running services..." >> $LOG
killall astel_rtspd 2>/dev/null

# 4. Install native ARMv4 binaries
echo "[*] Installing native binaries to /mtd/bin..." >> $LOG
cp -f $PAYLOAD/astel_rtspd /mtd/bin/astel_rtspd
cp -f $PAYLOAD/dvr_auth /mtd/bin/dvr_auth
if [ -f $PAYLOAD/api_status ]; then
    cp -f $PAYLOAD/api_status /mtd/bin/api_status
fi
chmod 755 /mtd/bin/astel_rtspd /mtd/bin/dvr_auth

# 5. Install HTML5 Web Console assets
echo "[*] Installing modern Web Console to /mtd/web..." >> $LOG
cp -f $PAYLOAD/index.cgi /mtd/web/index.cgi
cp -f $PAYLOAD/api_status.cgi /mtd/web/api_status.cgi
cp -f $PAYLOAD/api_exec.cgi /mtd/web/api_exec.cgi
cp -f $PAYLOAD/jmuxer.min.js /mtd/web/jmuxer.min.js
chmod 755 /mtd/web/index.cgi /mtd/web/api_status.cgi /mtd/web/api_exec.cgi
chmod 644 /mtd/web/jmuxer.min.js

# 6. Install persistent startup configuration
echo "[*] Installing startup script /mtd/startup.sh..." >> $LOG
cp -f $PAYLOAD/startup.sh /mtd/startup.sh
chmod 755 /mtd/startup.sh

# 7. Start root telnet daemon immediately
echo "[*] Activating root telnet daemon on port 23..." >> $LOG
/usr/sbin/telnetd -l /bin/sh &

# 8. Create snapshot symlinks
ln -sf /tmp/live_0.h264 /secube/web/live_0.h264
ln -sf /tmp/live_1.h264 /secube/web/live_1.h264
[ -e /tmp/live_2.h264 ] && ln -sf /tmp/live_2.h264 /secube/web/live_2.h264
[ -e /tmp/live_3.h264 ] && ln -sf /tmp/live_3.h264 /secube/web/live_3.h264

# 9. Launch RTSP daemon
echo "[*] Starting astel_rtspd on port 554..." >> $LOG
(/mtd/bin/astel_rtspd >/tmp/astel_rtspd.log 2>&1 &) &

# 10. Finalize and write completion marker to USB drive
echo "[+] SUCCESS: Clinton Shadow DVR Toolkit installed successfully!" >> $LOG
echo "    - RTSP Server:  rtsp://<dvr-ip>:554/live/0 .. 3" >> $LOG
echo "    - Web Console:  http://<dvr-ip>/" >> $LOG
echo "    - Telnet Shell: telnet <dvr-ip> 23" >> $LOG
echo "Completed at: `date`" >> $LOG

# Write confirmation file to USB drive so user can inspect on PC
cp -f $LOG "$USB_MNT/INSTALL_SUCCESS.txt"

# Restore filename so it won't repeatedly loop if USB drive stays plugged in
if [ -f "$USB_MNT/rc.upgrade.tmp" ]; then
    mv -f "$USB_MNT/rc.upgrade.tmp" "$USB_MNT/rc.upgrade.ext.done"
fi

sync
umount $USB_MNT 2>/dev/null

echo "Installation finished cleanly."
exit 0
